// Property Management System - PostgreSQL Schema (Render)
// Run: npx prisma db push (dev) or npx prisma migrate dev (production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH & USERS (NextAuth.js Credentials) ============
enum Role {
  SUPER_ADMIN
  BUILDING_OWNER
  PROPERTY_MANAGER
  ACCOUNTANT
  TENANT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  supabaseId    String?   @unique @map("supabase_id")
  fullName      String    @map("full_name")
  phone         String?
  role          Role      @default(TENANT)
  avatarUrl     String?   @map("avatar_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenantProfile         TenantProfile?
  ownedBuildings        Building[]       @relation("BuildingOwner")
  managedBuildings      Building[]       @relation("PropertyManager")
  announcements         Announcement[]
  announcementReads     AnnouncementRead[]
  maintenanceRequests   MaintenanceRequest[]  @relation("RequestedBy")
  maintenanceAssigned   MaintenanceRequest[]  @relation("AssignedTo")
  payments              Payment[]
  accessLogs            AccessLog[]
  uploadedDocuments     TenantDocument[]
  recordedIncomes       Income[]
  approvedExpenses      Expense[]        @relation("ExpenseApprover")
  activityLogs          ActivityLog[]
  paymentProofs         InvoicePaymentProof[]
  reviewedLeaveRequests LeaveRequest[]   @relation("LeaveRequestReviewer")
}

// ============ BUILDINGS & UNITS ============
model Building {
  id              String   @id @default(cuid())
  name            String
  address         String
  city            String
  state           String?
  zipCode         String?  @map("zip_code")
  country         String   @default("Ethiopia")
  numberOfFloors  Int      @map("number_of_floors")
  numberOfRooms   Int?     @map("number_of_rooms")
  parkingSpaces   Int      @default(0) @map("parking_spaces")
  areaHectares    Decimal? @map("area_hectares") @db.Decimal(10, 4)
  hasSecurityRoom Boolean  @default(false) @map("has_security_room")
  yearBuilt       Int?     @map("year_built")
  photoUrl        String?  @map("photo_url")
  utilitiesInfo   String?  @map("utilities_info")
  notes           String?
  ownerId         String?  @map("owner_id")
  managerId       String?  @map("manager_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  owner           User?    @relation("BuildingOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  manager         User?    @relation("PropertyManager", fields: [managerId], references: [id], onDelete: SetNull)
  units           Unit[]
  expenses        Expense[]
  incomes         Income[]
  announcements   Announcement[]
  visitorLogs     VisitorLog[]
}

enum UnitType {
  ROOM
  SHOP
  OFFICE
  RESTAURANT
  CLINIC
  APARTMENT
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

model Unit {
  id            String     @id @default(cuid())
  buildingId    String     @map("building_id")
  unitNumber    String     @map("unit_number")
  floorNumber   Int        @map("floor_number")
  unitType      UnitType   @default(ROOM) @map("unit_type")
  sizeSqm       Decimal    @map("size_sqm") @db.Decimal(10, 2)
  rentAmount           Decimal    @map("rent_amount") @db.Decimal(12, 2)
  quarterlyRentDueDate DateTime?  @map("quarterly_rent_due_date") @db.Date
  leaseStart           DateTime?  @map("lease_start") @db.Date
  leaseEnd      DateTime?  @map("lease_end") @db.Date
  status        UnitStatus @default(AVAILABLE)
  notes         String?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  building            Building            @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant              TenantProfile?
  invoices            Invoice[]
  maintenanceRequests MaintenanceRequest[]
  utilityReadings     UtilityReading[]
  assignmentHistory   TenantUnitHistory[]
  leaveRequests       LeaveRequest[]

  @@unique([buildingId, unitNumber])
}

// ============ TENANT ============
enum TenantStatus {
  ACTIVE
  PENDING
  VACATED
  SUSPENDED
}

enum DocumentType {
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  LEASE_AGREEMENT
  RENTAL_AGREEMENT
  OTHER
  ID
  TRADE_LICENSE
  CIVIL_DEFENSE_APPROVAL
  NOTICE
  NOC_LETTER
}

model TenantProfile {
  id                String        @id @default(cuid())
  userId            String        @unique @map("user_id")
  unitId            String?       @unique @map("unit_id")
  address           String?
  nationalId        String?       @map("national_id")
  occupation        String?
  businessType      String?       @map("business_type")
  tenantStatus      TenantStatus  @default(ACTIVE) @map("tenant_status")
  idDocumentUrl     String?       @map("id_document_url")
  leaseAgreementUrl String?       @map("lease_agreement_url")
  emergencyContact  String?       @map("emergency_contact")
  emergencyPhone    String?       @map("emergency_phone")
  moveInDate        DateTime?     @map("move_in_date") @db.Date
  moveOutDate       DateTime?     @map("move_out_date") @db.Date
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit              Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  documents         TenantDocument[]
  unitHistory       TenantUnitHistory[]
  incomes           Income[]
  smsLogs           SmsNotificationLog[]
  paymentProofs     InvoicePaymentProof[]
  leaveRequests     LeaveRequest[]
}

model TenantDocument {
  id           String       @id @default(cuid())
  tenantId     String       @map("tenant_id")
  type         DocumentType
  fileName     String       @map("file_name")
  fileUrl      String       @map("file_url")
  mimeType     String?      @map("mime_type")
  version      Int          @default(1)
  uploadedById String?      @map("uploaded_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  tenant       TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}

model TenantUnitHistory {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  unitId     String    @map("unit_id")
  assignedAt DateTime  @map("assigned_at") @db.Date
  vacatedAt  DateTime? @map("vacated_at") @db.Date
  notes      String?

  tenant     TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit       Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

// ============ INVOICES & RENT ============
enum BillingPeriod {
  MONTHLY
  QUARTERLY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceCategory {
  RENT
  ELECTRICITY
  WATER
}

model Invoice {
  id            String          @id @default(cuid())
  unitId        String          @map("unit_id")
  tenantId      String?         @map("tenant_id")
  category      InvoiceCategory @default(RENT)
  periodType    BillingPeriod   @default(QUARTERLY) @map("period_type")
  month         Int?
  year          Int
  quarter       Int?
  periodStart   DateTime?     @map("period_start") @db.Date
  periodEnd     DateTime?     @map("period_end") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  amount        Decimal       @db.Decimal(12, 2)
  latePenalty   Decimal       @default(0) @map("late_penalty") @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  unit          Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  payments      Payment[]
  smsLogs       SmsNotificationLog[]
  paymentProofs InvoicePaymentProof[]
}

enum PaymentProofType {
  IMAGE
  DOCUMENT
  URL
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

model InvoicePaymentProof {
  id                     String             @id @default(cuid())
  invoiceId              String?            @map("invoice_id")
  tenantId               String             @map("tenant_id")
  proofType              PaymentProofType   @map("proof_type")
  fileUrl                String?            @map("file_url")
  fileName               String?            @map("file_name")
  billingUrl             String?            @map("billing_url")
  notes                  String?
  status                 PaymentProofStatus @default(PENDING)
  submittedById          String             @map("submitted_by_id")
  extractedAmount        Decimal?           @map("extracted_amount") @db.Decimal(12, 2)
  extractedPayerName     String?            @map("extracted_payer_name")
  extractedPaymentDate   DateTime?          @map("extracted_payment_date") @db.Date
  extractedTransactionId String?            @map("extracted_transaction_id")
  extractedRawText       String?            @map("extracted_raw_text")
  extractionStatus       String?            @default("PENDING") @map("extraction_status")
  incomeId               String?            @map("income_id")
  createdAt              DateTime           @default(now()) @map("created_at")

  invoice                Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant                 TenantProfile      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submittedBy            User               @relation(fields: [submittedById], references: [id], onDelete: Cascade)
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_MONEY
  CARD
  OTHER
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String        @map("invoice_id")
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  receiptUrl    String?       @map("receipt_url")
  receiptNumber String?       @map("receipt_number")
  reference     String?
  paidAt        DateTime      @map("paid_at") @db.Date
  recordedById  String?       @map("recorded_by_id")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")

  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy    User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)
}

// ============ INCOME ============
enum IncomeType {
  RENTAL
  PARKING
  ADVANCE_PAYMENT
  DEPOSIT
  ADDITIONAL_CHARGE
  OTHER
}

model Income {
  id           String     @id @default(cuid())
  buildingId   String     @map("building_id")
  tenantId     String?    @map("tenant_id")
  type         IncomeType
  amount       Decimal    @db.Decimal(12, 2)
  description  String?
  incomeDate   DateTime   @map("income_date") @db.Date
  recordedById String?    @map("recorded_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  building     Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenant       TenantProfile? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  recordedBy   User?          @relation(fields: [recordedById], references: [id], onDelete: SetNull)
}

// ============ EXPENSES ============
enum ExpenseCategory {
  CLEANING
  SECURITY
  WATER
  ELECTRICITY
  MAINTENANCE
  REPAIR
  ADMINISTRATIVE
  MISCELLANEOUS
  UTILITIES
  INSURANCE
  TAXES
  OTHER
}

enum ExpenseApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Expense {
  id             String                @id @default(cuid())
  buildingId     String                @map("building_id")
  category       ExpenseCategory
  amount         Decimal               @db.Decimal(12, 2)
  description    String?
  receiptUrl     String?               @map("receipt_url")
  expenseDate    DateTime              @map("expense_date") @db.Date
  approvalStatus ExpenseApprovalStatus @default(PENDING) @map("approval_status")
  approvedById   String?               @map("approved_by_id")
  approvedAt     DateTime?             @map("approved_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  building       Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  approvedBy     User?    @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
}

// ============ SMS NOTIFICATIONS ============
enum SmsNotificationType {
  RENT_REMINDER_15_DAYS
  RENT_REMINDER_7_DAYS
  RENT_DUE_TODAY
  RENT_OVERDUE
  ANNOUNCEMENT
  MANUAL
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model SmsSettings {
  id                    String   @id @default("default")
  enabled               Boolean  @default(true)
  smsethiopiaApiKey     String?  @map("smsethiopia_api_key")
  contactPhone          String?  @map("contact_phone")
  ownerPhone            String?  @map("owner_phone")
  testTenantPhone       String?  @map("test_tenant_phone")
  customMessageTemplate String?  @map("custom_message_template") @db.Text
  alertDays15           Boolean  @default(true) @map("alert_days_15")
  alertDays7            Boolean  @default(true) @map("alert_days_7")
  alertDueToday         Boolean  @default(true) @map("alert_due_today")
  alertOverdue          Boolean  @default(true) @map("alert_overdue")
  alertHour             Int      @default(8) @map("alert_hour")
  remindersEnabled      Boolean  @default(true) @map("reminders_enabled")
  updatedAt             DateTime @updatedAt @map("updated_at")
}

model SmsNotificationLog {
  id           String              @id @default(cuid())
  tenantId     String?             @map("tenant_id")
  invoiceId    String?             @map("invoice_id")
  phone        String
  message      String              @db.Text
  type         SmsNotificationType
  status       SmsStatus           @default(PENDING)
  sentAt       DateTime?           @map("sent_at")
  errorMessage String?             @map("error_message")
  createdAt    DateTime            @default(now()) @map("created_at")

  tenant       TenantProfile? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  invoice      Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

// ============ ACTIVITY LOG ============
model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ============ ANNOUNCEMENTS ============
enum AnnouncementType {
  GENERAL
  MAINTENANCE_NOTICE
  EMERGENCY
  RENT_REMINDER
}

model Announcement {
  id            String           @id @default(cuid())
  buildingId    String?          @map("building_id")
  authorId      String           @map("author_id")
  type          AnnouncementType @default(GENERAL)
  title         String
  body          String           @db.Text
  targetFloors  Int[]            @default([]) @map("target_floors")
  targetUnitIds String[]         @default([]) @map("target_unit_ids")
  sendSms       Boolean          @default(false) @map("send_sms")
  createdAt     DateTime         @default(now()) @map("created_at")

  building      Building?        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reads         AnnouncementRead[]
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String       @map("announcement_id")
  userId         String       @map("user_id")
  readAt         DateTime     @default(now()) @map("read_at")
  reply          String?      @db.Text

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ MAINTENANCE ============
enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model MaintenanceRequest {
  id            String            @id @default(cuid())
  unitId        String            @map("unit_id")
  requestedById String            @map("requested_by_id")
  title         String
  description   String            @db.Text
  imageUrls     String[]          @default([]) @map("image_urls")
  urgency       UrgencyLevel      @default(MEDIUM)
  status        MaintenanceStatus @default(PENDING)
  assignedToId  String?           @map("assigned_to_id")
  cost          Decimal?          @db.Decimal(12, 2)
  completedAt   DateTime?         @map("completed_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  unit          Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  requestedBy   User              @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  assignedTo    User?             @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
}

// ============ ACCESS & SECURITY ============
model VisitorLog {
  id          String    @id @default(cuid())
  buildingId  String    @map("building_id")
  visitorName String    @map("visitor_name")
  purpose     String?
  unitId      String?   @map("unit_id")
  checkIn     DateTime  @map("check_in")
  checkOut    DateTime? @map("check_out")
  createdAt   DateTime  @default(now()) @map("created_at")

  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model AccessLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ UTILITY BILLING ============
model UtilityReading {
  id          String   @id @default(cuid())
  unitId      String   @map("unit_id")
  type        String
  reading     Decimal  @db.Decimal(12, 2)
  readingDate DateTime @map("reading_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

// ============ LEAVE / VACATE REQUESTS ============
enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id                   String             @id @default(cuid())
  tenantId             String             @map("tenant_id")
  unitId               String             @map("unit_id")
  requestedMoveOutDate DateTime           @map("requested_move_out_date") @db.Date
  reason               String?
  status               LeaveRequestStatus @default(PENDING)
  reviewedById         String?            @map("reviewed_by_id")
  adminNotes           String?            @map("admin_notes")
  reviewedAt           DateTime?          @map("reviewed_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant     TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit       Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  reviewedBy User?         @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}
